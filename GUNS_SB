    pcall(cleanupJesterAudio)
    -- A limpeza continua mesmo se um componente antigo der erro.
    if deathSoundConnection then pcall(function() deathSoundConnection:Disconnect() end) end
    pcall(function() if footstepAudio then footstepAudio:Stop() end end)
    pcall(function() reloadAudioFolder:Destroy() end)
    pcall(function() RunService:UnbindFromRenderStep(renderStepName) end)
