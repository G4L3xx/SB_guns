local function startLagGunOnHit(targetPlayer,targetCharacter)
    if not active or not kstgFns.isLatest() then return end
    if not targetPlayer or not targetCharacter or targetPlayer==plr then return end
    if targetCharacter==plr.Character or targetPlayer.Character~=targetCharacter then return end
    if targetPlayer.Parent~=Players then return end
    local hum=targetCharacter:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return end

    -- Novo acerto no mesmo alvo reinicia apenas o prazo, sem criar dois loops.
    local existing=lagHitJobs[targetPlayer]
    if existing and existing.character==targetCharacter and existing.running then
        existing.deadline=os.clock()+LAG_DURATION
        return
    end
    local job={character=targetCharacter,deadline=os.clock()+LAG_DURATION,running=true}
    lagHitJobs[targetPlayer]=job
    task.spawn(function()
        while active and kstgFns.isLatest() and lagHitJobs[targetPlayer]==job
            and targetPlayer~=plr and targetPlayer.Parent==Players
            and targetPlayer.Character==targetCharacter
            and targetCharacter~=plr.Character
            and os.clock()<job.deadline do
            local health=targetCharacter:FindFirstChildOfClass("Humanoid")
            if not health or health.Health<=0 then break end
            if not lagMasterGeneralHit or not lagMasterGeneralHit.Parent then
                lagMasterGeneralHit=ReplicatedStorage:FindFirstChild("GeneralHit")
            end
            if lagMasterGeneralHit and lagMasterGeneralHit:IsA("RemoteEvent") then
                -- Apenas UMA parte externa do alvo por ciclo. Nunca usar
                -- HumanoidRootPart do atirador ou varrer Players:GetPlayers().
                -- Evita sete chamadas em rajada (possivel resposta inesperada).
                local part=targetCharacter:FindFirstChild("Torso")
                    or targetCharacter:FindFirstChild("UpperTorso")
                    or targetCharacter:FindFirstChild("Head")
                if part and part:IsA("BasePart")
                    and part:IsDescendantOf(targetCharacter)
                    and not (plr.Character and part:IsDescendantOf(plr.Character)) then
                    pcall(function() lagMasterGeneralHit:FireServer(part) end)
                end
            end
            task.wait(1/LAG_TIME)
        end
        job.running=false
        if lagHitJobs[targetPlayer]==job then lagHitJobs[targetPlayer]=nil end
    end)
end
