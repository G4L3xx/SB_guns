-- Movimento local da peca JA PRESENTE no OBJ da AWM.
-- O eixo fica na raiz do pequeno puxador do lado direito do rifle.
local function awmOriginalBoltOffset(turn,slide)
    -- Posicionamento medido nos vertices originais da peca marcada:
    -- X de .044 ate .211; Y de .130 ate .229; Z de .447 ate .533.
    -- Giro em torno da base e recuo sobre o eixo longitudinal da AWM.
    local scale=arenaState.awm.scale or 1.4
    local pivot=Vector3.new(.051,.168,.487)*scale
    local rearward=.65*scale*slide
    return CFrame.new(0,.015*scale*turn,rearward)
        *CFrame.new(pivot)
        *CFrame.Angles(0,0,math.rad(78)*turn)
        *CFrame.new(-pivot)
end
