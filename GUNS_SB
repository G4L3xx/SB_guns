local Lighting=game:GetService("Lighting")
local perfSaved={}
local perfRestore={}
local perfThreadActive=true
local perfEnabled=true
local function perfSet(inst,property,value)
    if not perfThreadActive or not perfEnabled then return end
    local ok,oldValue=pcall(function() return inst[property] end)
    if not ok or oldValue==value then return end
    local success=pcall(function() inst[property]=value end)
    if success then
        perfSaved[#perfSaved+1]={inst=inst,property=property,old=oldValue,new=value}
    end
end
local function isPlayerCharacter(inst)
    local ancestor=inst
    while ancestor and ancestor~=workspace do
        if ancestor:IsA("Model") and Players:GetPlayerFromCharacter(ancestor) then return true end
        ancestor=ancestor.Parent
    end
    return false
end
local function optimizeEnvironment(inst)
    if not perfThreadActive or not perfEnabled or not inst or inst:IsDescendantOf(base) then return end
    -- Preserve characters and their visual cues.
    if isPlayerCharacter(inst) then return end
    if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
        perfSet(inst,"Enabled",false)
    elseif inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
        perfSet(inst,"Enabled",false)
    elseif inst:IsA("BasePart") then
        perfSet(inst,"CastShadow",false)
    end
end
