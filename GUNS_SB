-- Tempos de animacoes exclusivamente cosmeticas do viewmodel.
local awmLastBoltShot=-100
local function smoothCycle(x)
    x=math.clamp(x,0,1)
    return x*x*(3-2*x)
end
-- Ciclo visual de AWM usado depois do tiro e durante RELOAD.
-- A contagem de municao do jogo nao depende dessa animacao.
local function awmBoltPhase()
    if isReloading then
        return math.clamp(reloadProgress,0,1)
    end
    local t=(os.clock()-awmLastBoltShot)/1.16
    return (t>=0 and t<=1) and t or -1
end
local function boltTravel(t)
    -- Primeiro a alavanca original sobe, depois corre para tras;
    -- fica puxada por tempo suficiente para o movimento ser visto.
    if t<0 or t<.10 then return 0,0 end
    if t<.25 then return smoothCycle((t-.10)/.15),0 end
    if t<.43 then return 1,smoothCycle((t-.25)/.18) end
    if t<.61 then return 1,1 end
    if t<.80 then return 1,1-smoothCycle((t-.61)/.19) end
    if t<.96 then return 1-smoothCycle((t-.80)/.16),0 end
    return 0,0
end
-- Declarada antes da funcao de animacao para evitar ler _G.arenaState.
