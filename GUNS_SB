    for i,inst in ipairs(objects) do
        if not perfThreadActive then break end
        if perfEnabled then optimizeEnvironment(inst) end
        if i%180==0 then task.wait() end
    end
    objects=nil
end)
local perfAdded=workspace.DescendantAdded:Connect(function(inst)
    -- defer evita trabalho imediato no evento de criacao
    task.defer(function() optimizeEnvironment(inst) end)
end)
local function restoreEnvironment()
    -- Restaura o ambiente sem destruir o script: pode ser ligado novamente.
    perfEnabled=false
    for i=#perfSaved,1,-1 do
        local item=perfSaved[i]
        if item.inst and item.inst.Parent then
            pcall(function()
                if item.inst[item.property]==item.new then
                    item.inst[item.property]=item.old
                end
            end)
        end
    end
    table.clear(perfSaved)
end
local function setEnvironmentEnabled(enabled)
    if not perfThreadActive or perfEnabled==enabled then return end
    if not enabled then
        restoreEnvironment()
        return
    end
    perfEnabled=true
    for _,v in ipairs(Lighting:GetChildren()) do
        if v:IsA("BloomEffect") or v:IsA("BlurEffect")
            or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
            perfSet(v,"Enabled",false)
        end
    end
    perfSet(Lighting,"GlobalShadows",false)
    task.spawn(function()
        for i,inst in ipairs(workspace:GetDescendants()) do
            if not active or not perfThreadActive or not perfEnabled then return end
            optimizeEnvironment(inst)
            if i%180==0 then task.wait() end
        end
    end)
end
