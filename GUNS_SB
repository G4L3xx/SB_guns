-- Silencia localmente apenas os sons associados ao efeito Jester.
-- A habilidade do servidor ainda acontece; tiros, reload e hitmarker
-- pertencem ao nosso SoundService e nao entram nesse filtro.
local markJesterAudioWindow=function() end
local cleanupJesterAudio=function() end
do
    local audioService=game:GetService("SoundService")
    local targetWindows=setmetatable({}, {__mode="k"})
    local observed=setmetatable({}, {__mode="k"})
    local muted=setmetatable({}, {__mode="k"})
    local audioConnections={}
    -- IDs de efeitos de Jester listados no banco de sons do Slap Battles:
    -- seis risadas, pie splat e arremesso da torta.
    local jesterAudioIds={
        ["617500399"]=true, ["3604140002"]=true,
        ["5067325041"]=true, ["15378745416"]=true,
        ["18220413259"]=true, ["3071032374"]=true,
        ["517040733"]=true, ["15446418068"]=true,
    }
    local function hasKnownJesterId(sound)
        local id=tostring(sound.SoundId):match("(%d+)")
        return id~=nil and jesterAudioIds[id]==true
    end
    local function hasAbilityName(sound)
        local node=sound
        while node and node~=workspace and node~=audioService do
            local n=node.Name:lower()
            if n:find("jester",1,true) or n:find("joker",1,true)
                or n:find("ability3",1,true) or n:find("chester",1,true)
                or n:find("cardthrow",1,true) or n:find("playingcard",1,true)
                or n:find("cardsound",1,true) then
                return true
            end
            node=node.Parent
        end
        return false
    end
    local function isOurAudio(sound)
        local node=sound
        while node do
            if node.Name=="KSTG_M4_Reload_Audio" then return true end
            node=node.Parent
        end
        return false
    end
    local function isFromJesterWindow(sound)
        if not arenaState.jesterSoundsMuted then return false end
        if not active or not kstgFns.isLatest() or not sound.Parent or isOurAudio(sound) then
            return false
        end
        -- Jester e seus sons conhecidos ficam mudos mesmo se outro jogador
        -- soltar a habilidade fora da nossa rajada.
        if hasKnownJesterId(sound) then return true end
        local now=os.clock()
        local hasWindow=false
        for target,deadline in pairs(targetWindows) do
            if deadline>now then
                hasWindow=true
                local char=target.Character
                if char and sound:IsDescendantOf(char) then return true end
                local part=sound.Parent
                while part and not part:IsA("BasePart") do part=part.Parent end
                if part and char then
                    local root=char:FindFirstChild("HumanoidRootPart")
                    if root and (part.Position-root.Position).Magnitude<=17 then
                        return true
                    end
                end
            end
        end
        -- Efeitos da Jester que usam um Sound global, sem posicao 3D:
        -- pelo nome, so enquanto uma ativacao esta acontecendo.
        return hasWindow and hasAbilityName(sound)
    end
    local function silence(sound)
        if not isFromJesterWindow(sound) then return end
        if muted[sound]==nil then
            muted[sound]=sound.Volume
            task.spawn(function()
                -- Continua abafando um Sound reutilizado durante a rajada.
                while active and kstgFns.isLatest() and sound.Parent and muted[sound]~=nil
                    and isFromJesterWindow(sound) do
                    if sound.Volume~=0 then sound.Volume=0 end
                    if sound.IsPlaying then pcall(function() sound:Stop() end) end
                    task.wait(0.08)
                end
                local original=muted[sound]
                muted[sound]=nil
                if sound.Parent and original~=nil then
                    pcall(function() sound.Volume=original end)
                end
            end)
        end
        pcall(function()
            sound.Volume=0
            if sound.IsPlaying then sound:Stop() end
        end)
    end
    local function observeSound(sound,skipInitial)
        if not sound:IsA("Sound") or observed[sound] then return end
        observed[sound]=true
        table.insert(audioConnections,sound.Played:Connect(function() silence(sound) end))
        -- Tambem acompanha sons que comecem a tocar via alteracao de Playing.
        table.insert(audioConnections,sound:GetPropertyChangedSignal("Playing"):Connect(function()
            if sound.Playing then silence(sound) end
        end))
        if not skipInitial then silence(sound) end
    end
    local function observeExisting(container)
        if not container then return end
        for _,obj in ipairs(container:GetDescendants()) do
            if obj:IsA("Sound") then observeSound(obj,true) end
        end
    end
    markJesterAudioWindow=function(target)
        if not arenaState.jesterSoundsMuted then return end
        if not active or not kstgFns.isLatest() or not target then return end
        local previous=targetWindows[target]
        targetWindows[target]=os.clock()+0.75
        -- O mesmo som pode ser reutilizado em varios disparos; instala
        -- os ouvintes uma unica vez para cada Sound existente.
        if not previous then
            observeExisting(target.Character)
            observeExisting(plr.Character)
            observeExisting(audioService)
        end
    end
    -- OFF devolve imediatamente os volumes originais; ON reativa a escuta.
    arenaState.setJesterSoundsMuted=function(enabled)
        arenaState.jesterSoundsMuted=not not enabled
        if not enabled then
            table.clear(targetWindows)
            for snd,originalVolume in pairs(muted) do
                muted[snd]=nil
                if snd.Parent and originalVolume~=nil then
                    pcall(function() snd.Volume=originalVolume end)
                end
            end
        else
            observeExisting(audioService)
        end
    end
    -- Alguns sons globais ja existem antes da primeira ativacao;
    -- assim tambem detectamos reuso desses Sound.Played.
    observeExisting(audioService)
    table.insert(audioConnections,workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("Sound") then observeSound(obj,false) end
    end))
    table.insert(audioConnections,audioService.DescendantAdded:Connect(function(obj)
        if obj:IsA("Sound") then observeSound(obj,false) end
    end))
    cleanupJesterAudio=function()
        for _,connection in ipairs(audioConnections) do
            pcall(function() connection:Disconnect() end)
        end
        for sound,volume in pairs(muted) do
            if sound.Parent then pcall(function() sound.Volume=volume end) end
        end
        table.clear(muted)
        table.clear(targetWindows)
    end
end

function kstgFns.fireShot()
    if not active or not arenaState.gunInArena or running or isReloading then return end
    if characterHumanoid and characterHumanoid.Health<=0 then return end
    local now=os.clock()
    if not arenaState.infShot and ammo<=0 then
        if now-lastDryShot>=0.35 then
            lastDryShot=now
            if emptyClickSound then
                pcall(function()
                    emptyClickSound.TimePosition=0
                    emptyClickSound:Play()
                end)
            end
        end
        return
    end
    local awmShot=arenaState.activeGun=="AWM"
    local lagGunShot=arenaState.activeGun=="LAG"
    local berettaShot=arenaState.activeGun=="BERETTA"
    local cooldown=awmShot and 1.65 or (lagGunShot and .55 or (berettaShot and .24 or shotInterval))
    if not arenaState.noCooldown and now-lastShot<cooldown then return end
    lastShot=now
    if not arenaState.infShot then ammo=ammo-1 end
    if awmShot then awmLastBoltShot=now end
    recoilKick=math.min(awmShot and .34 or .18,
        recoilKick+(awmShot and .18 or (lagGunShot and .11 or (berettaShot and .075 or .038))))
    -- Efeito local: M4A1 usa seu audio original; AWM tem um tiro proprio.
    -- Clones permitem disparos consecutivos sem interromper o som anterior.
    local selectedShotSound=awmShot and sniperShotAudioTemplate or shotAudioTemplate
    if selectedShotSound then
        local shot=selectedShotSound:Clone()
        shot.Parent=selectedShotSound.Parent
        if berettaShot then shot.PlaybackSpeed=1.19 end
        shotDebris:AddItem(shot,2.8)
        pcall(function() shot:Play() end)
    end
    arenaState.refreshAmmoDisplay()
    if lagGunShot then
        local target,hitCharacter=kstgFns.confirmedShotTarget()
        if target and hitCharacter then
            kstgFns.playLocalHitSound()
            startLagGunOnHit(target,hitCharacter)
        end
        return
    end
    if awmShot then
        -- AWM: ao atingir um jogador, faz no maximo 30 solicitacoes
        -- com intervalo de 0.1 segundo e prazo de 4 segundos.
        -- O servidor decide quais ativacoes sao validas e aplica efeitos.
        local targetPlayer,hitModel=kstgFns.confirmedShotTarget()
        if targetPlayer and hitModel then
            -- O mesmo raycast confirmado dispara som + 15 cartas da AWM.
            kstgFns.playLocalHitSound()
            arenaState.awm.hitEffects(hitModel,15)
            if not jesterRemote or not jesterRemote.Parent then
                jesterRemote=ReplicatedStorage:FindFirstChild("GeneralAbility")
            end
            if jesterRemote and jesterRemote:IsA("RemoteEvent") then
                -- AWM: ate 30 solicitacoes por alvo acertado,
                -- separadas por 0.1 segundo, dentro de 4 segundos.
                -- O servidor decide se aceita cada ativacao.
                local lockedTarget=targetPlayer
                local lockedCharacter=hitModel
                local abilityRemote=jesterRemote
                local existing=awmJesterSpamByTarget[lockedTarget]
                if existing and existing.character==lockedCharacter
                    and existing.running then
                    existing.deadline=os.clock()+4
                    existing.sent=0
                else
                    local job={
                        character=lockedCharacter,
                        deadline=os.clock()+4,
                        sent=0,
                        running=true
                    }
                    awmJesterSpamByTarget[lockedTarget]=job
                    task.spawn(function()
                        while active and kstgFns.isLatest()
                            and awmJesterSpamByTarget[lockedTarget]==job
                            and job.running
                            and job.sent<30
                            and os.clock()<job.deadline do
                            if not lockedTarget.Parent
                                or lockedTarget.Character~=lockedCharacter
                                or not abilityRemote.Parent then
                                break
                            end
                            markJesterAudioWindow(lockedTarget)
                            pcall(function()
                                abilityRemote:FireServer("Ability3",lockedTarget)
                            end)
                            job.sent+=1
                            if job.sent<30 then
                                task.wait(0.1)
                            end
                        end
                        job.running=false
                        if awmJesterSpamByTarget[lockedTarget]==job then
                            awmJesterSpamByTarget[lockedTarget]=nil
                        end
                    end)
                end
            end
        end
        return
    end
    if berettaShot then
        -- BERETTA: nenhum GeneralAbility("Ability3") local: esse evento
        -- ativa a habilidade de quem chamou e nao e dano validado de bala.
        -- Enviar um acerto somente numa parte fisica do OUTRO jogador.
        local target,hitModel,hitPart=kstgFns.confirmedShotTarget()
        if target and target~=plr and hitModel and hitModel~=plr.Character then
            kstgFns.playLocalHitSound()
            local bodyPart=hitModel:FindFirstChild("Torso")
                or hitModel:FindFirstChild("UpperTorso")
                or hitModel:FindFirstChild("HumanoidRootPart")
            if not bodyPart and hitPart and hitPart:IsA("BasePart")
                and hitPart:IsDescendantOf(hitModel) then
                bodyPart=hitPart
            end
            local remote=ReplicatedStorage:FindFirstChild("GeneralHit")
            if bodyPart and bodyPart:IsA("BasePart")
                and bodyPart:IsDescendantOf(hitModel)
                and not (plr.Character and bodyPart:IsDescendantOf(plr.Character))
                and remote and remote:IsA("RemoteEvent") then
                -- Um unico pedido de acerto; resposta e decidida pelo servidor.
                pcall(function() remote:FireServer(bodyPart) end)
            end
        end
        return
    end
    local target,hitModel=kstgFns.confirmedShotTarget()
    if target and hitModel then
        -- Som de acerto e UMA unica carta sobre o alvo confirmado.
        kstgFns.playLocalHitSound()
        arenaState.awm.hitEffects(hitModel,1)
        if not jesterRemote or not jesterRemote.Parent then
            jesterRemote=ReplicatedStorage:FindFirstChild("GeneralAbility")
        end
        if jesterRemote and jesterRemote:IsA("RemoteEvent") then
            markJesterAudioWindow(target)
            pcall(function()
                jesterRemote:FireServer("Ability3",target)
            end)
        end
    end
end

