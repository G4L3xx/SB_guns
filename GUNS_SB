    local function groupOnScreen(camera,cf,group)
        local lo,hi=group.lo,group.hi
        local view=camera.ViewportSize
        local margin=175 -- tolerancia conservadora para evitar buracos nas bordas
        local left,right,above,below=true,true,true,true
        for i=0,1 do
            for j=0,1 do
                for k=0,1 do
                    local p=cf:PointToWorldSpace(Vector3.new(
                        i==0 and lo.X or hi.X,
                        j==0 and lo.Y or hi.Y,
                        k==0 and lo.Z or hi.Z))
                    local screen=camera:WorldToViewportPoint(p)
                    -- Geometria proxima/atravessando a camera permanece visivel.
                    if screen.Z<=0 then return true end
                    if screen.X>=-margin then left=false end
                    if screen.X<=view.X+margin then right=false end
                    if screen.Y>=-margin then above=false end
                    if screen.Y<=view.Y+margin then below=false end
                end
            end
        end
        return not (left or right or above or below)
    end

    function beretta.updateCulling(camera,cf)
        if not beretta.ready or not cf or not camera or model.Parent~=camera then return end
        local now=os.clock()
        if now<beretta.cullNext then return end
        beretta.cullNext=now+.12
        for _,group in ipairs(beretta.cullGroups) do
            local visible=groupOnScreen(camera,cf,group)
            if visible and not group.visible then
                group.model.Parent=model
                -- O grupo ficou parado quando estava fora da tela.
                -- Recupera seu CFrame usando o pivo original.
                group.model:PivotTo(cf*group.restPivot)
                group.visible=true
            elseif not visible and group.visible then
                group.model.Parent=nil
                group.visible=false
            end
        end
    end

    function beretta.update(camera,weaponPose,recoil,adsAlpha)
        if not camera or not beretta.ready or model.Parent~=camera then return nil end
        local blend=math.clamp(adsAlpha or 0,0,1)
        blend=blend*blend*(3-2*blend)
        -- O FBX original usa o eixo Z para o comprimento. Nao girar 90 graus.
        local hip=weaponPose*CFrame.new(-.02,.15,.68)
            *CFrame.Angles(rad(-3),rad(-5),rad(-2))
            *CFrame.Angles(recoil*.7,0,0)
        local ads=camera.CFrame*CFrame.new(0,-.40,-1.32)
            *CFrame.Angles(recoil*.13,0,0)
        local cf=hip:Lerp(ads,blend)
        model:PivotTo(cf)
        beretta.updateCulling(camera,cf)
        return cf
    end

    function beretta.destroy()
            destroyed=true
        serial+=1
        beretta.loading=false
        beretta.ready=false
        if model then model:Destroy() end
        if beretta.oldHolder then
            beretta.oldHolder:Destroy()
            beretta.oldHolder=nil
        end
    end
end

