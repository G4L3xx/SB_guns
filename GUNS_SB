    local function awmTriangle(a,b,c,color,isOriginalBoltFace)
        -- Retira APENAS as faces do corpo da luneta antiga, que era fechado.
        -- Escala ja aplicada ao receber os vertices; coordenadas normalizadas.
        -- A nova luneta oca e construida separadamente com aneis abertos.
        local localCenter=(a+b+c)/(3*awm.scale)
        if localCenter.Y>.315 and localCenter.Y<.89
           and localCenter.Z> -1.33 and localCenter.Z<.54
           and math.abs(localCenter.X)<.45 then
            return
        end
        local ab=(b-a).Magnitude
        local ac=(c-a).Magnitude
        local bc=(c-b).Magnitude
        if ab>=ac and ab>=bc then
            a,b,c=c,a,b
        elseif ac>=ab and ac>=bc then
            a,b,c=b,a,c
        end
        local edge=c-b
        local edgeLength=edge.Magnitude
        if edgeLength<.001 then return end
        local back=edge/edgeLength
        local projection=(a-b):Dot(back)
        local foot=b+back*projection
        local heightVec=a-foot
        local height=heightVec.Magnitude
        if height<.001 then return end
        local up=heightVec/height
        local function half(p0,p1,highAtEnd)
            local width=(p1-p0).Magnitude
            if width<.001 then return end
            local axis=(p1-p0).Unit
            local localBack=highAtEnd and axis or -axis
            local localRight=up:Cross(localBack)
            if localRight.Magnitude<.0001 then return end
            local midpoint=(p0+p1)*.5+up*(height*.5)
            local localCF=CFrame.fromMatrix(midpoint,localRight.Unit,up,localBack)
            local w=Instance.new("WedgePart")
            w.Name=isOriginalBoltFace and "AWM_OBJ_BoltOriginal" or "AWM_OBJ_Outer"
            w.Size=Vector3.new(.012,height+.003,width+.003)
            w.CFrame=root.CFrame*localCF
            w.Color=color
            w.Material=Enum.Material.SmoothPlastic
            w.Anchored=true
            w.CanCollide=false
            w.CanTouch=false
            w.CanQuery=false
            w.CastShadow=false
            w.Parent=model
            awmParts[#awmParts+1]=w
            if isOriginalBoltFace then
                awmOriginalBoltWedges[#awmOriginalBoltWedges+1]={w,localCF}
            end
            awmSurfaceGroup(w,localCF)
        end
        half(b,foot,true)
        half(foot,c,false)
    end

