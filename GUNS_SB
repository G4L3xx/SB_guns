    local function fillTriangle(parent,a,b,c,color)
        local ab=(b-a).Magnitude
        local ac=(c-a).Magnitude
        local bc=(c-b).Magnitude
        -- O lado maior como hipotenusa garante que o pe da altitude
        -- fique DENTRO do segmento, evitando triangulos destacados.
        if ab>=ac and ab>=bc then
            a,b,c=c,a,b
        elseif ac>=ab and ac>=bc then
            a,b,c=b,a,c
        end
        local edge=c-b
        local len=edge.Magnitude
        if len<.00015 then return 0 end
        local axis=edge/len
        local foot=b+axis*(a-b):Dot(axis)
        local heightVector=a-foot
        local height=heightVector.Magnitude
        if height<.00015 then return 0 end
        local up=heightVector/height
        local created=0
        local function half(p0,p1,highAtEnd)
            local extent=(p1-p0).Magnitude
            if extent<.00015 then return end
            local direction=(p1-p0)/extent
            local back=highAtEnd and direction or -direction
            local right=up:Cross(back)
            if right.Magnitude<.00015 then return end
            local center=(p0+p1)*.5+up*(height*.5)
            local wedge=Instance.new("WedgePart")
            wedge.Name="BERETTA_Exterior"
            wedge.Size=Vector3.new(THICKNESS,height+.0007,extent+.0007)
            wedge.CFrame=CFrame.fromMatrix(center,right.Unit,up,back)
            wedge.Color=color
            wedge.Material=Enum.Material.SmoothPlastic
            wedge.Reflectance=.02
            wedge.Anchored=true
            wedge.Massless=true
            wedge.CanCollide=false
            wedge.CanTouch=false
            wedge.CanQuery=false
            wedge.CastShadow=false
            wedge.Parent=parent
            created+=1
        end
        half(b,foot,true)
        half(foot,c,false)
        return created
    end

