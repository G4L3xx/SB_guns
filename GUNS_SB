function kstgFns.confirmedShotTarget()
    local camera=workspace.CurrentCamera
    if not camera then return nil,nil end
    rayParams.FilterDescendantsInstances={plr.Character,base,arenaState.awm.model,arenaState.lagGun.model,arenaState.beretta.model}
    local result=workspace:Raycast(camera.CFrame.Position,camera.CFrame.LookVector*650,rayParams)
    if not result then return nil,nil end
    local hitPart=result.Instance
    while hitPart and hitPart~=workspace do
        if hitPart:IsA("Model") and hitPart~=plr.Character then
            local humanoid=hitPart:FindFirstChildOfClass("Humanoid")
            if humanoid then
                if humanoid.Health<=0 then return nil,nil end
                local playerHit=Players:GetPlayerFromCharacter(hitPart)
                if playerHit and playerHit~=plr then
                    return playerHit,hitPart,result.Instance
                end
                return nil,nil
            end
        end
        hitPart=hitPart.Parent
    end
    return nil,nil
end

