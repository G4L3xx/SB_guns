arenaState.arenaFlagNames={"entered","Entered","InArena","inArena","IsInArena","isInArena"}
arenaState.lobbyFlagNames={"InLobby","inLobby","IsInLobby","isInLobby"}
function kstgFns.hasFlag(container,names)
    if not container then return false end
    for _,name in ipairs(names) do
        local child=container:FindFirstChild(name)
        if child and child:IsA("BoolValue") and child.Value then return true end
        if container:GetAttribute(name)==true then return true end
    end
    return false
end
function kstgFns.readFlag(container,names)
    if not container then return nil end
    local found=false
    for _,name in ipairs(names) do
        local child=container:FindFirstChild(name)
        if child and child:IsA("BoolValue") then
            found=true
            if child.Value then return true end
        end
        local attr=container:GetAttribute(name)
        if typeof(attr)=="boolean" then
            found=true
            if attr then return true end
        end
    end
    if found then return false end
    return nil
end
function kstgFns.matchesFlagName(name)
    for _,n in ipairs(arenaState.arenaFlagNames) do if n==name then return true end end
    for _,n in ipairs(arenaState.lobbyFlagNames) do if n==name then return true end end
    return false
end

function kstgFns.isProtectedGui(obj)
    if not obj or not obj:IsA("ScreenGui") then return true end
    if obj==ui then return true end
    local n=obj.Name:lower()
    return n=="touchgui" or n=="robloxgui" or n=="kstg_m4_display" or n=="kstg_m4_loading" or n=="kstg_m4_lobby" or n=="kstg_slap_gain_popup"
end

function kstgFns.restoreGameGuis()
    -- Muda o estado primeiro, antes de reativar, para os listeners
    -- nao esconderem a GUI novamente no mesmo frame.
    arenaState.arenaGuiHidden=false
    for _,c in ipairs(arenaState.hiddenGuiConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(arenaState.hiddenGuiConnections)
    for obj,wasEnabled in pairs(arenaState.hiddenGameGuis) do
        if obj and obj.Parent then
            pcall(function() obj.Enabled=wasEnabled end)
        end
        arenaState.hiddenGameGuis[obj]=nil
    end
end

function kstgFns.hideGameGui(obj)
    if not active or not arenaState.arenaGuiHidden or kstgFns.isProtectedGui(obj) then return end
    if arenaState.hiddenGameGuis[obj]==nil then
        arenaState.hiddenGameGuis[obj]=obj.Enabled
        local con=obj:GetPropertyChangedSignal("Enabled"):Connect(function()
            if active and arenaState.arenaGuiHidden and obj.Parent and obj.Enabled then
                obj.Enabled=false
            end
        end)
        arenaState.hiddenGuiConnections[#arenaState.hiddenGuiConnections+1]=con
    end
    if obj.Enabled then obj.Enabled=false end
end

function kstgFns.scanGameGuis()
    if not active or not arenaState.arenaGuiHidden then return end
    for _,obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("ScreenGui") then kstgFns.hideGameGui(obj) end
    end
end

function kstgFns.arenaStatus(character)
    -- Respawn, morte e personagem ausente sao lobby para a GUI.
    if not character or not character.Parent then return false,true end
    local hum=character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health<=0 then return false,true end
    -- Um marcador explicito de lobby tem prioridade sobre arena residual.
    if kstgFns.hasFlag(character,arenaState.lobbyFlagNames) or kstgFns.hasFlag(plr,arenaState.lobbyFlagNames) then
        return false
    end
    -- O estado do personagem tem prioridade: evita que um marcador antigo
    -- do Player mantenha a GUI escondida depois do respawn.
    local charState=kstgFns.readFlag(character,arenaState.arenaFlagNames)
    if charState~=nil then return charState,true end
    local playerState=kstgFns.readFlag(plr,arenaState.arenaFlagNames)
    if playerState~=nil then return playerState,true end
    -- Sem marcador da arena, assumir lobby. Isso permite exibir
    -- Config e Select gun mesmo antes do jogador entrar na arena.
    return false,false
end

function kstgFns.updateArenaGuis(character)
    if not active then return end
    local shouldShow,confirmed=kstgFns.arenaStatus(character)
    local previousGun=arenaState.activeGun
    arenaState.inArena=shouldShow
    -- Sem selecao: M4A1. NONE: nenhuma arma. AWM: modelo de teste.
    local currentGun=shouldShow and (arenaState.selectedGun or "M4A1") or nil
    if currentGun=="NONE" then currentGun=nil end
    arenaState.activeGun=currentGun
    arenaState.gunInArena=currentGun~=nil
    arenaState.updateLobbyButtons((not shouldShow) or currentGun==nil)
    ui.Enabled=arenaState.gunInArena
    if not arenaState.lowMode or not currentGun then arenaState.low.hide() end
    if arenaState.weaponModelReady then
        local destination=(currentGun=="M4A1" and not arenaState.lowMode) and workspace.CurrentCamera or nil
        if base.Parent~=destination then base.Parent=destination end
    end
    local awmDestination=(currentGun=="AWM" and not arenaState.lowMode) and workspace.CurrentCamera or nil
    if arenaState.awm.model.Parent~=awmDestination then
        arenaState.awm.model.Parent=awmDestination
    end
    local lagGunDestination=(currentGun=="LAG" and not arenaState.lowMode) and workspace.CurrentCamera or nil
    if arenaState.lagGun.model.Parent~=lagGunDestination then
        arenaState.lagGun.model.Parent=lagGunDestination
    end
    local berettaDestination=(currentGun=="BERETTA" and not arenaState.lowMode and arenaState.beretta.ready) and workspace.CurrentCamera or nil
    if arenaState.beretta.model.Parent~=berettaDestination then
        arenaState.beretta.model.Parent=berettaDestination
    end
    if currentGun~="AWM" then arenaState.awm.scope.Visible=false end
    if previousGun~=currentGun then
        if previousGun then arenaState.onWeaponHolstered(previousGun) end
        if currentGun then arenaState.onWeaponEquipped(currentGun) end
    elseif arenaState.gunInArena and inventoryState.paused then
        inventoryState.resume()
    end
    -- No PC nao ocultar OUTRAS GUIs do jogo: apenas quatro botoes
    -- de toque da nossa arma ficam ocultos (FIRE/RELOAD/RUN/AIM).
    if arenaState.pcControls then
        if arenaState.arenaGuiHidden or next(arenaState.hiddenGameGuis) then
            kstgFns.restoreGameGuis()
        end
    elseif arenaState.gunInArena and confirmed then
        if not arenaState.arenaGuiHidden then arenaState.arenaGuiHidden=true end
        kstgFns.scanGameGuis()
    elseif arenaState.arenaGuiHidden or next(arenaState.hiddenGameGuis) then
        kstgFns.restoreGameGuis()
    end
end

-- Alterna imediatamente entre geometria original e modelos arcade LOW.
arenaState.setLowMode=function(enabled)
    enabled=not not enabled
    if arenaState.lowMode==enabled then return end
    arenaState.lowMode=enabled
    if not enabled and arenaState.gunInArena then
        if arenaState.activeGun=="AWM" then arenaState.awm.ensureBuilt() end
        if arenaState.activeGun=="BERETTA" then arenaState.beretta.ensureBuilt() end
    end
    if enabled then
        -- Sem deixar viewmodels detalhados na camera, mesmo durante a troca.
        if base.Parent then base.Parent=nil end
        if arenaState.awm.model.Parent then arenaState.awm.model.Parent=nil end
        if arenaState.lagGun.model.Parent then arenaState.lagGun.model.Parent=nil end
        if arenaState.beretta.model.Parent then arenaState.beretta.model.Parent=nil end
    else
        arenaState.low.hide()
    end
    kstgFns.updateArenaGuis(plr.Character)
end

