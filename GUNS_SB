        block("LAG_PulseRail_"..i,Vector3.new(.32,.038,.19),
            .05,.20,z,brightIce,Enum.Material.Neon)
        block("LAG_SideIndicator_"..i,Vector3.new(.045,.095,.14),
            .29,-.03,z,frost,Enum.Material.Neon)
    end
    block("LAG_PowerCell",Vector3.new(.26,.40,.25),.05,-.45,-.12,
        silver,Enum.Material.Metal,CFrame.Angles(rad(11),0,rad(5)))

    function lagGun.update(camera,weaponPose,recoil,adsAlpha)
        if not camera or model.Parent~=camera then return nil end
        local t=math.clamp(adsAlpha or 0,0,1)
        t=t*t*(3-2*t)
        local hip=weaponPose*CFrame.new(-.10,.08,.23)
            *CFrame.Angles(rad(-3),rad(-4),rad(1))
            *CFrame.Angles(recoil*.5,0,0)
        local ads=camera.CFrame*CFrame.new(.0,-.36,-1.74)
            *CFrame.Angles(rad(-2),0,0)
        local final=hip:Lerp(ads,t)
        model:PivotTo(final)
        return final
    end

    function lagGun.destroy()
        model:Destroy()
    end
end


