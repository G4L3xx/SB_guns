local CULL_INTERVAL=.45
local CULL_MIN_DIST=65
local function cullEligible(obj)
    return obj:IsA("BasePart")
        and obj.Anchored and not obj.CanCollide
        and not obj.CanTouch and not obj.CanQuery
        and obj.Transparency<.95
        and obj.Size.Magnitude<35
        and obj.Parent and not obj:IsDescendantOf(base)
        and not isPlayerCharacter(obj)
end
local function cullAdd(obj)
    if not cullAlive or #cullCandidates>=CULL_MAX then return end
    if cullEligible(obj) and cullOriginal[obj]==nil then
        cullOriginal[obj]=obj.LocalTransparencyModifier
        cullCandidates[#cullCandidates+1]=obj
    end
end
task.spawn(function()
    local descendants=workspace:GetDescendants()
    for i,obj in ipairs(descendants) do
        if not cullAlive or #cullCandidates>=CULL_MAX then break end
        cullAdd(obj)
        if i%200==0 then task.wait() end
    end
end)
function kstgFns.updateCulling(dt)
    if not cullEnabled or not cullAlive then return end
    cullElapsed+=dt
    if cullElapsed<CULL_INTERVAL then return end
    cullElapsed=0
    local camera=workspace.CurrentCamera
    if not camera then return end
    local origin=camera.CFrame.Position
    local count=#cullCandidates
    if count==0 then return end
    for _=1,math.min(CULL_PER_TICK,count) do
        if cullCursor>count then cullCursor=1 end
        local obj=cullCandidates[cullCursor]
        cullCursor+=1
        if obj and obj.Parent then
            local distance=(obj.Position-origin).Magnitude
            local hidden=false
            if distance>CULL_MIN_DIST then
                local screen,inView=camera:WorldToViewportPoint(obj.Position)
                local margin=math.min(220,4500/math.max(distance,1))
                hidden=(not inView) or screen.X < -margin or screen.Y < -margin
                    or screen.X>camera.ViewportSize.X+margin
                    or screen.Y>camera.ViewportSize.Y+margin
            end
            local goal=hidden and 1 or (cullOriginal[obj] or 0)
            if obj.LocalTransparencyModifier~=goal then
                obj.LocalTransparencyModifier=goal
            end
        end
    end
end
local function pauseCulling()
    if not cullEnabled then return end
    cullEnabled=false
    for obj,original in pairs(cullOriginal) do
        if obj and obj.Parent then
            pcall(function() obj.LocalTransparencyModifier=original end)
        end
    end
end
local function restoreCulling()
    cullAlive=false
    if cullConnection then cullConnection:Disconnect() end
    for obj,original in pairs(cullOriginal) do
        if obj.Parent then
            pcall(function() obj.LocalTransparencyModifier=original end)
        end
    end
    table.clear(cullCandidates)
    table.clear(cullOriginal)
end
