            if not arenaState.gunInArena then openConfig() end
        elseif key==Enum.KeyCode.F2 then
            if not arenaState.gunInArena then openGunPanel() end
        elseif key==Enum.KeyCode.Escape then
            configPanel.Visible=false
            gunPanel.Visible=false
        elseif key==Enum.KeyCode.X then toggleCrosshair()
