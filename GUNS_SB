                end
            else
                if a>=.19 and not playedOut then
                    playedOut=true
                    kstgFns.playReloadSound(soundMagOut)
                end
                if a>=.69 and not playedIn then
                    playedIn=true
                    kstgFns.playReloadSound(soundMagIn)
                end
                if a>=.87 and not playedChamber then
                    playedChamber=true
                    kstgFns.playReloadSound(soundChamber)
                end
            end
            if a>=1 then break end
            task.wait()
        end
        if active and token==reloadToken then
            ammo=maxAmmo
            arenaState.refreshAmmoDisplay()
            isReloading=false
            reloadProgress=0
        end
    end)
end

