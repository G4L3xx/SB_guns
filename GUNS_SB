function kstgFns.monitorCharacterArena(character)
    -- No respawn libera imediatamente as GUIs do personagem anterior.
    kstgFns.restoreGameGuis()
    for _,c in ipairs(arenaState.arenaWatchConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(arenaState.arenaWatchConnections)

    local function monitorContainer(container)
        if not container then return end
        local function watchBool(child)
            if not child:IsA("BoolValue") or not kstgFns.matchesFlagName(child.Name) then return end
            arenaState.arenaWatchConnections[#arenaState.arenaWatchConnections+1]=child:GetPropertyChangedSignal("Value"):Connect(function()
                kstgFns.updateArenaGuis(plr.Character)
            end)
        end
        for _,child in ipairs(container:GetChildren()) do watchBool(child) end
        arenaState.arenaWatchConnections[#arenaState.arenaWatchConnections+1]=container.ChildAdded:Connect(function(child)
            watchBool(child)
            kstgFns.updateArenaGuis(plr.Character)
        end)
        arenaState.arenaWatchConnections[#arenaState.arenaWatchConnections+1]=container.ChildRemoved:Connect(function(child)
            if kstgFns.matchesFlagName(child.Name) then kstgFns.updateArenaGuis(plr.Character) end
        end)
        for _,name in ipairs(arenaState.arenaFlagNames) do
            arenaState.arenaWatchConnections[#arenaState.arenaWatchConnections+1]=container:GetAttributeChangedSignal(name):Connect(function()
                kstgFns.updateArenaGuis(plr.Character)
            end)
        end
        for _,name in ipairs(arenaState.lobbyFlagNames) do
            arenaState.arenaWatchConnections[#arenaState.arenaWatchConnections+1]=container:GetAttributeChangedSignal(name):Connect(function()
                kstgFns.updateArenaGuis(plr.Character)
            end)
        end
    end

    monitorContainer(character)
    monitorContainer(plr)
    if character then
        local function watchHumanoid(hum)
            if not hum:IsA("Humanoid") then return end
            arenaState.arenaWatchConnections[#arenaState.arenaWatchConnections+1]=hum.Died:Connect(function()
                kstgFns.updateArenaGuis(plr.Character)
            end)
        end
        for _,child in ipairs(character:GetChildren()) do
            if child:IsA("Humanoid") then watchHumanoid(child) end
        end
        arenaState.arenaWatchConnections[#arenaState.arenaWatchConnections+1]=character.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid") then watchHumanoid(child) end
        end)
    end
    kstgFns.updateArenaGuis(character)
end

