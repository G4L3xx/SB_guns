    -- Jester / Chester: explosao SIMULTANEA de 15 cartas somente ao acertar
    -- um personagem com Humanoid. Efeito local puramente visual, sem habilidade
    -- real de outros jogos ou alteracao de dano/status no servidor.
    local TweenService=game:GetService("TweenService")
    local Debris=game:GetService("Debris")
    function awm.hitEffects(targetModel,requestedCount)
        if not targetModel or not targetModel:IsA("Model") then return end
        local humanoid=targetModel:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health<=0 then return end

        local root=targetModel:FindFirstChild("HumanoidRootPart")
            or targetModel:FindFirstChild("UpperTorso")
            or targetModel:FindFirstChild("Torso")
            or targetModel:FindFirstChild("Head")
        if not root or not root:IsA("BasePart") then return end

        -- Um efeito so gera cartas; o disparo toca o som UMA vez,
        -- antes da animacao, para M4A1 e AWM igualmente.
        local suits={"♠","♥","♦","♣","J"}
        local count=math.clamp(tonumber(requestedCount) or 15,1,15)

        -- Todas as cartas sao criadas neste mesmo disparo, sem task.wait/delay.
        -- Ficarao presas visualmente ao personagem enquanto se espalham.
        for i=1,count do
            local angle=((i-1)/count)*math.pi*2
            if count==1 then angle=math.pi*.35 end
            local layer=math.floor((i-1)/5)
            local suit=suits[((i-1)%#suits)+1]
            local cardGui=Instance.new("BillboardGui")
            cardGui.Name="KSTG_Jester_"..count.."_Carta_"..i
            cardGui.Adornee=root
            cardGui.AlwaysOnTop=true
            cardGui.LightInfluence=0
            cardGui.Size=UDim2.fromOffset(32,44)
            cardGui.StudsOffsetWorldSpace=Vector3.new(
                math.cos(angle)*.65,
                -.65+layer*.65,
                math.sin(angle)*.65
            )
            cardGui.Parent=root

            local card=Instance.new("Frame")
            card.Name="Card"
            card.Size=UDim2.fromScale(1,1)
            card.BackgroundColor3=Color3.fromRGB(248,245,239)
            card.BorderSizePixel=0
            card.Rotation=(i%2==0) and 17 or -17
            card.ZIndex=3
            card.Parent=cardGui
            Instance.new("UICorner",card).CornerRadius=UDim.new(0,3)

            local stroke=Instance.new("UIStroke")
            stroke.Color=Color3.fromRGB(40,28,35)
            stroke.Thickness=1.5
            stroke.Parent=card

            local face=Instance.new("TextLabel")
            face.Size=UDim2.fromScale(1,1)
            face.BackgroundTransparency=1
            face.Text=suit
            face.Font=Enum.Font.GothamBold
            face.TextScaled=true
            face.TextStrokeTransparency=1
            face.TextColor3=(suit=="♥" or suit=="♦" or suit=="J")
                and Color3.fromRGB(204,35,59)
                or Color3.fromRGB(29,27,32)
            face.ZIndex=4
            face.Parent=card

            local limit=Instance.new("UITextSizeConstraint")
            limit.MaxTextSize=29
            limit.Parent=face

            local outward=Vector3.new(
                math.cos(angle)*(2.1+(i%3)*.22),
                -.05+layer*.85+(i%2)*.25,
                math.sin(angle)*(2.1+(i%3)*.22)
            )
            -- As quinze animacoes comecam imediatamente, juntas.
            TweenService:Create(
                cardGui,
                TweenInfo.new(.82,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
                {StudsOffsetWorldSpace=outward}
            ):Play()
            TweenService:Create(card,TweenInfo.new(.82),{
                Rotation=card.Rotation+((i%2==0) and 100 or -100),
                BackgroundTransparency=1
            }):Play()
            TweenService:Create(face,TweenInfo.new(.82),{
                TextTransparency=1
            }):Play()
            TweenService:Create(stroke,TweenInfo.new(.82),{
                Transparency=1
            }):Play()
            Debris:AddItem(cardGui,.95)
        end
    end

    -- ADS da AWM: a arma inteira SOBE do canto direito e alinha a lente
    -- TRASEIRA da luneta com o centro da camera (nao apenas aplica zoom).
    -- As coordenadas da luneta sao as mesmas usadas nas pecas do OBJ.
    function awm.update(camera,weaponPose,recoil,aiming,adsAlpha)
        if not model.Parent or not camera then return end

        local alpha=math.clamp(adsAlpha or 0,0,1)
        local eased=alpha*alpha*(3-2*alpha)

        -- Pose original de hip-fire da AWM. Mantem recarga, recuo, corrida.
        local hipPose=weaponPose
            *CFrame.new(.22,-.16,-1.02)
            *CFrame.Angles(math.rad(-2),math.rad(9),math.rad(-1))
            *CFrame.Angles(recoil*.5,0,0)

        -- ADS real pela propria luneta 3D: o ponto de observacao fica
        -- DENTRO do tubo, sem criar uma mira 2D sobreposta ao jogo.
        -- Deslocamos o viewmodel em relacao a camera, e nao a camera pelo
        -- mapa, para evitar ver atraves de paredes e quebrar controles.
        -- A traseira da luneta fica ligeiramente atras do olho da camera;
        -- assim a linha de visao passa pelo tubo aberto ate a reticula
        -- montada na lente frontal do OBJ.
        local scopeY=.423*awm.scale
        local scopeRearZ=.345*awm.scale
        local aimPose=camera.CFrame
            *CFrame.new(0,-scopeY,.08-scopeRearZ)
            *CFrame.Angles(recoil*.08,0,0)

        -- Transicao suave e reversivel, inclusive ao soltar AIM.
        local finalPose=hipPose:Lerp(aimPose,eased)
        model:PivotTo(finalPose)
        awm.updateOuterCulling(camera)

        -- O overlay so entra depois que o rifle terminou de subir.
        -- Antes disso, o usuario ve fisicamente o movimento da luneta.
        overlay.Visible=false -- mira esta dentro da luneta 3D
        return finalPose
    end

    function awm.destroy()
        for _,p in ipairs(awmParts) do
            if p then p:Destroy() end
        end
        model:Destroy()
        overlay:Destroy()
    end
end

