local metal=Color3.fromRGB(45,47,49)
-- Grupos de pecas por celula local para culling dinamico, sem destruir os detalhes.
local visibilityGroups={}
local groupCellSize=0.28
function kstgFns.registerSurface(part,localCF)
    local pos=localCF.Position
    local ix=math.floor(pos.X/groupCellSize)
    local iy=math.floor(pos.Y/groupCellSize)
    local iz=math.floor(pos.Z/groupCellSize)
    local key=ix..":"..iy..":"..iz
    local group=visibilityGroups[key]
    if not group then
        group={members={},min=pos,max=pos,shown=true}
        visibilityGroups[key]=group
        groupList[#groupList+1]=group
    end
    local minp=group.min
    local maxp=group.max
    local radius=part.Size.Magnitude*.5
    local r=Vector3.new(radius,radius,radius)
    group.min=Vector3.new(math.min(minp.X,pos.X-radius),math.min(minp.Y,pos.Y-radius),math.min(minp.Z,pos.Z-radius))
    group.max=Vector3.new(math.max(maxp.X,pos.X+radius),math.max(maxp.Y,pos.Y+radius),math.max(maxp.Z,pos.Z+radius))
    group.members[#group.members+1]={part=part,offset=localCF}
end
function kstgFns.wedgeTriangle(a,b,c)
    -- Area inferior do poco: seleciona os triangulos do carregador,
    -- nunca o cano, a coronha ou a mira da M4A1.
    local cY=(a.Y+b.Y+c.Y)/3
    local cZ=(a.Z+b.Z+c.Z)/3
    local isM4MagTriangle=cY<-.34 and cZ>-.42 and cZ<.25
    -- Use the longest side as the hypotenuse's horizontal base.
    local ab=(b-a).Magnitude
    local ac=(c-a).Magnitude
    local bc=(c-b).Magnitude
    if ab>=ac and ab>=bc then
        a,b,c=c,a,b
    elseif ac>=ab and ac>=bc then
        a,b,c=b,a,c
    end
    -- The longest side is now b -> c.
    local edge=c-b
    local length=edge.Magnitude
    if length < 0.00001 then return end
    local back=edge/length
    local proj=(a-b):Dot(back)
    local foot=b+back*proj
    local heightVec=a-foot
    local height=heightVec.Magnitude
    if height<0.00001 then return end
    local up=heightVec/height
    local right=up:Cross(back)
    if right.Magnitude<0.0001 then return end
    right=right.Unit
    local thick=0.008
    local function addHalf(startPoint,endPoint,highAtEnd)
        local width=(endPoint-startPoint).Magnitude
        if width<0.00001 then return end
        local axis=(endPoint-startPoint).Unit
        -- WedgePart slopes across local Z; align triangular cross section in the plane.
        -- Height is at the +Z end; flip Z on the other half to meet at the common altitude.
        local localBack=highAtEnd and axis or -axis
        local localRight=up:Cross(localBack).Unit
        local midpoint=(startPoint+endPoint)*0.5+up*(height*0.5)
        local cf=CFrame.fromMatrix(midpoint,localRight,up,localBack)
        local w=Instance.new("WedgePart")
        w.Name=isM4MagTriangle and "M4_DetachableMagazineSurface" or "M4_Surface"
        w.Size=Vector3.new(thick,height,width)
        w.CFrame=cf
        w.Color=metal
        w.Material=Enum.Material.SmoothPlastic
        w.Anchored=true
        w.CanCollide=false
        w.CanTouch=false
        w.CanQuery=false
        w.CastShadow=false
        w.Parent=base
        if isM4MagTriangle then
            -- Os wedges do carregador nao entram no culling por celulas:
            -- durante a recarga sao movidos juntos, sem snaps da malha.
            m4DetachableMagazine[#m4DetachableMagazine+1]={part=w,offset=cf}
        else
            kstgFns.registerSurface(w,cf)
        end
        made+=1
    end
    -- The altitude foot may be slightly outside an edge due to floating point errors.
    -- For an obtuse triangle, the projection may genuinely fall outside.
    -- Split based on the longest edge, which guarantees that the altitude is inside.
    addHalf(b,foot,true)
    addHalf(foot,c,false)
end
-- Coordenadas calculadas somente na exibicao
-- Spawn gradually to avoid freezing a single frame.
for i,f in ipairs(triangles) do
    if not active or not kstgFns.isLatest() then break end
    kstgFns.wedgeTriangle(vertices[f[1]],vertices[f[2]],vertices[f[3]])
    if i%110==0 then
        label.Text=("M4A1: %d/%d triangulos | %d pecas"):format(i,#triangles,made)
        __loadingText.Text=label.Text
        task.wait()
    end
end
vertices=nil
triangles=nil
if not kstgFns.isLatest() then
    active=false
    pcall(inventoryState.cleanupSlapNotifications)
    base:Destroy()
    ui:Destroy()
    return
end
