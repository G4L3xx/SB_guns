    pcall(function() arenaState.characterRemovingConnection:Disconnect() end)
    for _,c in ipairs(arenaState.arenaWatchConnections) do pcall(function() c:Disconnect() end) end
    for _,c in ipairs(inventoryState.connections) do pcall(function() c:Disconnect() end) end
    pcall(inventoryState.cleanupSlapNotifications)
    kstgFns.restoreGameGuis()
    pcall(inventoryState.restore)
    pcall(function()
        if characterHumanoid and characterHumanoid.Parent then
            characterHumanoid.WalkSpeed=normalSpeed
        end
    end)
    pcall(restoreCulling)
    pcall(restoreEnvironment)
    perfThreadActive=false
    if perfAdded then pcall(function() perfAdded:Disconnect() end) end
    pcall(function() base:Destroy() end)
    pcall(function() arenaState.awm.destroy() end)
    pcall(function() arenaState.lagGun.destroy() end)
    pcall(function() arenaState.beretta.destroy() end)
    pcall(function() arenaState.low.destroy() end)
    pcall(function() ui:Destroy() end)
    pcall(function()
        if arenaState.lobbyGui then arenaState.lobbyGui:Destroy() end
    end)
    if kstgFns.isLatest() then
        pcall(function() plr.CameraMode=previousMode end)
        pcall(function()
            local camera=workspace.CurrentCamera
            if camera then camera.FieldOfView=previousFOV end
        end)
    end
    -- Nao deixar ponteiro apontando para uma M4A1 desligada.
    if _G.KstgM4Stop==stop then
        _G.KstgM4Stop=nil
    end
    if __loadingGui and __loadingGui.Parent then
        pcall(function() __loadingGui:Destroy() end)
    end
end
