-- A geometria permanece em cache; grupos fora da tela saem do Model.
-- Retornam com o CFrame correto quando entram no campo de visao.
-- Movimento da malha do carregador original, independente dos demais wedges.
-- Quando fica fora da tela, a mesma malha retorna como o carregador novo.
local magazineWasMoving=false
function kstgFns.updateM4DetachableMagazine(weaponPose)
    if #m4DetachableMagazine==0 then return end
    if not isReloading or arenaState.activeGun~="M4A1" then
        if magazineWasMoving then
            for _,entry in ipairs(m4DetachableMagazine) do
                if entry.part.Parent~=base then entry.part.Parent=base end
                entry.part.CFrame=weaponPose*entry.offset
            end
            magazineWasMoving=false
        end
        return
    end
    magazineWasMoving=true
    local t=math.clamp(reloadProgress,0,1)
    local yDown=0
    local slightTilt=0
    local visible=true
    if t<.19 then
        yDown=0
    elseif t<.37 then
        local k=kstgFns.easeHand((t-.19)/.18)
        yDown=.86*k
        slightTilt=math.rad(-12)*k
    elseif t<.48 then
        visible=false -- carregador gasto saiu do enquadramento
    elseif t<.77 then
        local k=kstgFns.easeHand((t-.48)/.29)
        yDown=1.02*(1-k)
        slightTilt=math.rad(6)*(1-k)
    end
    local anchor=CFrame.new(0,-.57,-.06)
    local motion=anchor
        *CFrame.new(0,-yDown,0)
        *CFrame.Angles(slightTilt,0,math.rad(4)*(yDown>0 and 1 or 0))
        *anchor:Inverse()
    for _,entry in ipairs(m4DetachableMagazine) do
        if visible then
            if entry.part.Parent~=base then entry.part.Parent=base end
            entry.part.CFrame=weaponPose*motion*entry.offset
        else
            if entry.part.Parent then entry.part.Parent=nil end
        end
    end
end

local hiddenParts=0
local cullCursor=1
local cullAccumulator=0
local groupsPerPass=math.max(1,math.ceil(#groupList/10))
function kstgFns.groupInView(group,camera,weaponPose)
    local minp,maxp=group.min,group.max
    local w,h=camera.ViewportSize.X,camera.ViewportSize.Y
    local margin=95
    local allLeft,allRight,allTop,allBottom,allBehind=true,true,true,true,true
    for xi=0,1 do
        for yi=0,1 do
            for zi=0,1 do
                local localPoint=Vector3.new(xi==0 and minp.X or maxp.X,yi==0 and minp.Y or maxp.Y,zi==0 and minp.Z or maxp.Z)
                local px,onScreen=camera:WorldToViewportPoint(weaponPose:PointToWorldSpace(localPoint))
                if px.Z>0 then
                    allBehind=false
                    if px.X>=-margin then allLeft=false end
                    if px.X<=w+margin then allRight=false end
                    if px.Y>=-margin then allTop=false end
                    if px.Y<=h+margin then allBottom=false end
                end
            end
        end
    end
    return not (allBehind or allLeft or allRight or allTop or allBottom)
end
function kstgFns.updateWeaponCulling(dt,camera,weaponPose)
    cullAccumulator+=dt
    if cullAccumulator<.16 then return end
    cullAccumulator=0
    for _=1,groupsPerPass do
        if cullCursor>#groupList then cullCursor=1 end
        local group=groupList[cullCursor]
        cullCursor+=1
        if group then
            local show=kstgFns.groupInView(group,camera,weaponPose)
            if show~=group.shown then
                group.shown=show
                for _,entry in ipairs(group.members) do
                    if show then
                        entry.part.CFrame=weaponPose*entry.offset
                        entry.part.Parent=base
                        hiddenParts-=1
                    else
                        entry.part.Parent=nil
                        hiddenParts+=1
                    end
                end
            end
        end
    end
end
