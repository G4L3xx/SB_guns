-- KSTG | SLAP GAIN POPUP
-- Mostra +N slaps ao aumentar o contador real do jogador.
-- Nao modifica slaps, armas nem eventos do servidor.
-- ============================================================
do
    local TweenService=game:GetService("TweenService")
    local oldPopupGui=pg:FindFirstChild("KSTG_SLAP_GAIN_POPUP")
    if oldPopupGui then oldPopupGui:Destroy() end

    local popupGui=Instance.new("ScreenGui")
    popupGui.Name="KSTG_SLAP_GAIN_POPUP"
    popupGui.ResetOnSpawn=false
    popupGui.IgnoreGuiInset=true
    popupGui.DisplayOrder=1250
    popupGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    popupGui.Parent=pg

    local connections={}
    local statConnection=nil
    local statsAddConnection=nil
    local statsRemoveConnection=nil
    local source=nil
    local previousValue=nil
    local popupSequence=0
    local stopped=false

    local function popupSlaps(gain)
        if stopped or not active or gain<=0 then return end
        popupSequence+=1
        -- Quatro alturas alternadas evitam que ganhos consecutivos se sobreponham.
        local lane=(popupSequence-1)%4
        local startY=0.335+lane*0.043

        local label=Instance.new("TextLabel")
        label.Name="SlapGain"
        label.AnchorPoint=Vector2.new(0.5,0.5)
        label.Size=UDim2.fromOffset(260,42)
        label.Position=UDim2.fromScale(0.5,startY)
        label.BackgroundTransparency=1
        label.BorderSizePixel=0
        label.Font=Enum.Font.GothamBold
        label.TextSize=27
        label.TextColor3=Color3.fromRGB(88,255,130)
        label.TextStrokeColor3=Color3.fromRGB(5,16,9)
        label.TextStrokeTransparency=0.15
        label.TextTransparency=0
        label.TextXAlignment=Enum.TextXAlignment.Center
        label.Text="+"..tostring(gain).." slaps"
        label.ZIndex=20
        label.Parent=popupGui

        local up=TweenService:Create(label,TweenInfo.new(
            1.05,Enum.EasingStyle.Quad,Enum.EasingDirection.Out
        ),{
            Position=UDim2.fromScale(0.5,startY-0.105),
            TextTransparency=1,
            TextStrokeTransparency=1
        })
        up.Completed:Connect(function()
            if label then label:Destroy() end
        end)
        up:Play()
    end

    local function getSource()
        local leaderstats=plr:FindFirstChild("leaderstats")
        if leaderstats then
            local stat=leaderstats:FindFirstChild("Slaps") or leaderstats:FindFirstChild("slaps")
            if stat and (stat:IsA("IntValue") or stat:IsA("NumberValue")) then
                return stat,stat.Value
            end
        end
        local upper=plr:GetAttribute("Slaps")
        if type(upper)=="number" then return "attribute:Slaps",upper end
        local lower=plr:GetAttribute("slaps")
        if type(lower)=="number" then return "attribute:slaps",lower end
        return nil,nil
    end

    local refresh
    refresh=function()
        if stopped or not active then return end
        local newSource,newValue=getSource()
        if newSource~=source then
            if statConnection then statConnection:Disconnect() end
            statConnection=nil
            source=newSource
            -- A primeira leitura (e mudancas de origem) nao sao ganhos.
            previousValue=newValue
            if typeof(newSource)=="Instance" then
                statConnection=newSource:GetPropertyChangedSignal("Value"):Connect(refresh)
            end
            return
        end
        if type(newValue)=="number" and type(previousValue)=="number" then
            local gained=newValue-previousValue
            if gained>0 then
                local amount=math.floor(gained*1000+0.5)/1000
                popupSlaps(amount)
            end
        end
        previousValue=newValue
    end

    local function watchLeaderstats()
        if statsAddConnection then statsAddConnection:Disconnect() end
        if statsRemoveConnection then statsRemoveConnection:Disconnect() end
        statsAddConnection=nil
        statsRemoveConnection=nil
        local leaderstats=plr:FindFirstChild("leaderstats")
        if leaderstats then
            statsAddConnection=leaderstats.ChildAdded:Connect(refresh)
            statsRemoveConnection=leaderstats.ChildRemoved:Connect(refresh)
        end
        refresh()
    end

    connections[#connections+1]=plr.ChildAdded:Connect(function(obj)
        if obj.Name=="leaderstats" then watchLeaderstats() end
    end)
    connections[#connections+1]=plr.ChildRemoved:Connect(function(obj)
        if obj.Name=="leaderstats" then watchLeaderstats() end
    end)
    connections[#connections+1]=plr:GetAttributeChangedSignal("Slaps"):Connect(refresh)
    connections[#connections+1]=plr:GetAttributeChangedSignal("slaps"):Connect(refresh)
    watchLeaderstats()

    inventoryState.cleanupSlapNotifications=function()
        if stopped then return end
        stopped=true
        for _,connection in ipairs(connections) do
            connection:Disconnect()
        end
        if statConnection then statConnection:Disconnect() end
        if statsAddConnection then statsAddConnection:Disconnect() end
        if statsRemoveConnection then statsRemoveConnection:Disconnect() end
        if popupGui then popupGui:Destroy() end
    end
end

