function kstgFns.easeHand(x)
    x=math.clamp(x,0,1)
    return x*x*(3-2*x)
end
local rightGrip=CFrame.new(.24,-.37,.22)*CFrame.Angles(math.rad(-28),0,math.rad(12))
local rightADS=CFrame.new(.22,-.33,.21)*CFrame.Angles(math.rad(-26),0,math.rad(9))
local leftSupport=CFrame.new(-.23,-.22,-.74)*CFrame.Angles(math.rad(-36),0,math.rad(-12))
local leftADS=CFrame.new(-.22,-.20,-.76)*CFrame.Angles(math.rad(-30),0,math.rad(-8))
local leftMagazine=CFrame.new(-.15,-.62,-.08)*CFrame.Angles(math.rad(-9),0,math.rad(9))
local leftRemove=CFrame.new(-.19,-1.14,-.10)*CFrame.Angles(math.rad(12),0,math.rad(-10))
local leftDrop=CFrame.new(-.31,-1.24,.10)*CFrame.Angles(math.rad(19),math.rad(-8),math.rad(-15))
local leftFresh=CFrame.new(-.23,-1.12,-.18)*CFrame.Angles(math.rad(-6),0,math.rad(10))
local leftInsert=CFrame.new(-.14,-.63,-.08)*CFrame.Angles(math.rad(-7),0,math.rad(8))
function kstgFns.leftReloadPose(t)
    -- M4A1: pega o carregador vazio, retira, larga, busca outro e encaixa.
    if t<.12 then return leftSupport:Lerp(leftMagazine,kstgFns.easeHand(t/.12)) end
    if t<.19 then return leftMagazine end
    if t<.33 then return leftMagazine:Lerp(leftRemove,kstgFns.easeHand((t-.19)/.14)) end
    if t<.42 then return leftRemove:Lerp(leftDrop,kstgFns.easeHand((t-.33)/.09)) end
    if t<.51 then return leftDrop:Lerp(leftFresh,kstgFns.easeHand((t-.42)/.09)) end
    if t<.70 then return leftFresh:Lerp(leftInsert,kstgFns.easeHand((t-.51)/.19)) end
    if t<.77 then return leftInsert end
    return leftInsert:Lerp(leftSupport,kstgFns.easeHand((t-.77)/.23))
end
function kstgFns.animateArmSegment(part,startPos,endPos,thickness)
    local delta=endPos-startPos
    local len=delta.Magnitude
    if len<.01 then return end
    part.Size=Vector3.new(thickness,len,thickness)
    part.CFrame=CFrame.lookAt((startPos+endPos)*.5,endPos)*CFrame.Angles(math.rad(90),0,0)
end
function kstgFns.animateHands(root)
    local wave=math.sin(walkClock)*.012*walkBlend*(1-adsBlend)
    local rp=rightGrip:Lerp(rightADS,adsBlend)*CFrame.new(0,wave,0)
    local lp=leftSupport:Lerp(leftADS,adsBlend)*CFrame.new(0,-wave,0)
    -- Durante a corrida, mao esquerda solta um pouco o guarda-mao
    -- e mao direita acompanha a arma abaixada.
    local stride=math.sin(walkClock)
    local sprintRight=rightGrip*CFrame.new(.025,-.035+stride*.03,.025)
    local sprintLeft=leftSupport*CFrame.new(-.05,-.11-stride*.055,.08)
    -- Mantem o movimento da corrida, mesmo durante a recarga.
    rp=rp:Lerp(sprintRight,sprintBlend)
    lp=lp:Lerp(sprintLeft,sprintBlend)
    if isReloading then
        -- Preserva a troca animada do carregador da M4A1.
        lp=kstgFns.leftReloadPose(reloadProgress)
    elseif inspectWeight>.001 then
        -- Inspecao: a mao esquerda desliza pelo guarda-mao, observa o
        -- carregador e volta ao apoio, sem criar articulacoes R15.
        local progress=inspectProgress
        local traverse=.5-.5*math.cos(progress*math.pi*2)
        local checkMagazine=leftMagazine*CFrame.new(-.065,.14,-.06)
            *CFrame.Angles(math.rad(-10),math.rad(-13),math.rad(14))
        local leftInspection=leftSupport:Lerp(checkMagazine,traverse)
        lp=lp:Lerp(leftInspection,inspectWeight)
        local rightInspection=rightGrip*CFrame.new(.02,-.025,.035)
            *CFrame.Angles(math.rad(8),math.rad(6),math.rad(-7))
        rp=rp:Lerp(rightInspection,inspectWeight*.8)
    end
    local rh=root*rp
    local lh=root*lp
    armPieces.rightHand.CFrame=rh
    armPieces.leftHand.CFrame=lh
    local rs=root*CFrame.new(.56,-1.01,.81)
    local ls=root*CFrame.new(-.58,-1.00,.23)
    kstgFns.animateArmSegment(armPieces.right,rs.Position,rh.Position,.34)
    kstgFns.animateArmSegment(armPieces.left,ls.Position,lh.Position,.34)
end

-- A AWM usa as próprias peças originais de mãos/braços R6 da M4A1.
-- Ao trocar armas, as peças são movidas (não clonadas nem duplicadas).
-- O braço segue o mesmo método de animação da M4A1.
arenaState.awm.updateHands=function(awmRoot,adsAlpha)
    if not active or not awmRoot then return end
    for _,piece in pairs(armPieces) do
        if piece.Parent~=arenaState.awm.model then
            piece.Parent=arenaState.awm.model
        end
    end
    local bob=math.sin(walkClock)*.012*walkBlend
    local aimT=math.clamp(adsAlpha or 0,0,1)
    aimT=aimT*aimT*(3-2*aimT)
    local rightHip=awmRoot
        *CFrame.new(.24,-.45+bob,.45)
        *CFrame.Angles(math.rad(-25),0,math.rad(11))
    local leftHip=awmRoot
        *CFrame.new(-.27,-.29-bob,-1.00)
        *CFrame.Angles(math.rad(-32),0,math.rad(-11))
    -- Ao mirar, as maos acompanham o rifle e ajustam a pegada.
    local rightAds=awmRoot
        *CFrame.new(.20,-.43,.41)
        *CFrame.Angles(math.rad(-22),0,math.rad(7))
    local leftAds=awmRoot
        *CFrame.new(-.25,-.28,-1.02)
        *CFrame.Angles(math.rad(-28),0,math.rad(-7))
    local rightPose=rightHip:Lerp(rightAds,aimT)
    local leftPose=leftHip:Lerp(leftAds,aimT)
    if isReloading then
        -- Nao reproduz a recarga de carregador da M4A1 na AWM.
        -- A mao de apoio estabiliza o rifle enquanto a outra faz o ciclo.
        leftPose=leftPose:Lerp(leftHip, .40*math.sin(reloadProgress*math.pi))
    elseif inspectWeight>.001 then
        local inspectPose=awmRoot
            *CFrame.new(-.26,-.39,-.36)
            *CFrame.Angles(math.rad(-14),0,math.rad(-5))
        leftPose=leftPose:Lerp(inspectPose,inspectWeight*.85)
    end
    -- Animacao AWM: a mao direita acompanha a pequena peca movel
    -- logo apos o disparo ou durante a recarga. Nenhuma mudanca de dano.
    local boltT=awmBoltPhase()
    if boltT>=0 then
        local turn,slide=boltTravel(boltT)
        local reach=boltT<.10 and smoothCycle(boltT/.10)
            or (boltT<.96 and 1 or 1-smoothCycle((boltT-.96)/.04))
        local boltGrip=awmRoot*awmOriginalBoltOffset(turn,slide)
            *CFrame.new(.195*arenaState.awm.scale,
                .182*arenaState.awm.scale,.49*arenaState.awm.scale)
            *CFrame.Angles(math.rad(-30),0,math.rad(16+turn*7))
        rightPose=rightPose:Lerp(boltGrip,math.clamp(reach,0,1))
    end
    armPieces.rightHand.CFrame=rightPose
    armPieces.leftHand.CFrame=leftPose
    local rightShoulder=awmRoot*CFrame.new(.56,-.91,1.09)
    local leftShoulder=awmRoot*CFrame.new(-.62,-.98,.24)
    kstgFns.animateArmSegment(armPieces.right,rightShoulder.Position,rightPose.Position,.34)
    kstgFns.animateArmSegment(armPieces.left,leftShoulder.Position,leftPose.Position,.34)
end

-- LAG GUN compartilha as mesmas maos R6, sem duplicar bracos de avatar.
arenaState.beretta.updateHands=function(berettaRoot,adsAlpha)
    if not active or not berettaRoot then return end
    for _,piece in pairs(armPieces) do
        if piece.Parent~=arenaState.beretta.model then
            piece.Parent=arenaState.beretta.model
        end
    end
    local t=math.clamp(adsAlpha or 0,0,1)
    t=t*t*(3-2*t)
    local rightHip=berettaRoot*CFrame.new(.24,-.78,.85)
        *CFrame.Angles(math.rad(-22),0,math.rad(9))
    local rightAds=berettaRoot*CFrame.new(.22,-.75,.81)
        *CFrame.Angles(math.rad(-26),0,math.rad(4))
    local leftHip=berettaRoot*CFrame.new(-.19,-.42,.15)
        *CFrame.Angles(math.rad(-23),0,math.rad(-6))
    local leftAds=berettaRoot*CFrame.new(-.13,-.39,.17)
        *CFrame.Angles(math.rad(-24),0,math.rad(-4))
    local right=rightHip:Lerp(rightAds,t)
    local left=leftHip:Lerp(leftAds,t)
    if isReloading then
        local reloadT=math.sin(math.clamp(reloadProgress,0,1)*math.pi)
        left=left*CFrame.new(-.10,-.31,.20)*CFrame.Angles(math.rad(-10)*reloadT,0,0)
    end
    armPieces.rightHand.CFrame=right
    armPieces.leftHand.CFrame=left
    local rs=berettaRoot*CFrame.new(.56,-1.04,1.05)
    local ls=berettaRoot*CFrame.new(-.54,-.93,.30)
    kstgFns.animateArmSegment(armPieces.right,rs.Position,right.Position,.34)
    kstgFns.animateArmSegment(armPieces.left,ls.Position,left.Position,.34)
end

arenaState.lagGun.updateHands=function(lagGunRoot,adsAlpha)
    if not active or not lagGunRoot then return end
    for _,piece in pairs(armPieces) do
        if piece.Parent~=arenaState.lagGun.model then
            piece.Parent=arenaState.lagGun.model
        end
    end
    local t=math.clamp(adsAlpha or 0,0,1)
    local right=rightGrip:Lerp(rightADS,t)
    local left=leftSupport:Lerp(leftADS,t)
    if isReloading then
        left=kstgFns.leftReloadPose(reloadProgress)
    end
    local rp=lagGunRoot*right
    local lp=lagGunRoot*left
    armPieces.rightHand.CFrame=rp
    armPieces.leftHand.CFrame=lp
    local rs=lagGunRoot*CFrame.new(.56,-1.01,.81)
    local ls=lagGunRoot*CFrame.new(-.58,-1.00,.23)
    kstgFns.animateArmSegment(armPieces.right,rs.Position,rp.Position,.34)
    kstgFns.animateArmSegment(armPieces.left,ls.Position,lp.Position,.34)
end

local function pose()
    local camera=workspace.CurrentCamera
    if not camera then return CFrame.new() end
    -- Hip: posicao classica de CS, canto inferior direito da tela.
    -- ADS corrigido: alinha mais alto o buraco da mira no centro da camera.
    -- Mira fixa, sem botoes extras.
    local hip=CFrame.new(1.02,-1.12,-2.93)*CFrame.Angles(math.rad(-4),math.rad(-11),math.rad(-4))
    local ads=CFrame.new(.03,adsY,-2.70)
    local offset=hip:Lerp(ads,adsBlend)
    -- Pose de corrida estilo FPS: arma abaixa, recua e inclina.
    -- Interpolacao evita qualquer salto ao iniciar/parar RUN.
    local sprintPose=CFrame.new(.83,-1.50,-2.72)*CFrame.Angles(math.rad(-19),math.rad(-22),math.rad(12))
    -- Durante RELOAD, o personagem continua correndo na mesma velocidade,
    -- mas aproxima a arma para a troca do carregador ficar visivel.
    local visibleSprintBlend=sprintBlend*(isReloading and .28 or 1)
    offset=offset:Lerp(sprintPose,visibleSprintBlend)
    -- Baixa e gira a arma durante a recarga, como um viewmodel FPS.
    local reloadAmount=isReloading and math.sin(reloadProgress*math.pi) or 0
    if arenaState.activeGun=="AWM" then
        -- Mantem o rifle estavel para o movimento do ferrolho ficar visivel.
        offset=offset*CFrame.new(-.045*reloadAmount,-.18*reloadAmount,.13*reloadAmount)
            *CFrame.Angles(math.rad(-8)*reloadAmount,0,math.rad(-7)*reloadAmount)
    else
        -- M4A1 inclinada para mostrar claramente a troca de carregadores.
        offset=offset*CFrame.new(-.07*reloadAmount,-.30*reloadAmount,.18*reloadAmount)
            *CFrame.Angles(math.rad(-17)*reloadAmount,0,math.rad(-16)*reloadAmount)
    end
    offset=offset*CFrame.new(0,0,recoilKick)*CFrame.Angles(recoilKick*1.3,0,0)
    -- Inspecao AFK: levanta a M4A1 e a gira para observar as laterais.
    -- Usa a mesma arma original e a mesma camera, sem novas pecas pesadas.
    if inspectWeight>.001 then
        local sweep=math.sin(inspectProgress*math.pi*2)
        local incline=math.sin(inspectProgress*math.pi)
        offset=offset*CFrame.new(-.34*inspectWeight,.25*inspectWeight,.36*inspectWeight)
            *CFrame.Angles(
                math.rad(7+10*incline)*inspectWeight,
                math.rad(-16+30*sweep)*inspectWeight,
                math.rad(-9+11*sweep)*inspectWeight
            )
    end
    -- Animacao de pulo sem alterar a posicao da mira ao mirar.
    -- A arma sobe no impulso e inclina levemente enquanto o personagem cai.
    local jumpFade=1-adsBlend*.70
    local jumpTransform=CFrame.new(
        0,
        (jumpLift*.14 - jumpBlend*.10 - jumpImpact*.16)*jumpFade,
        (jumpBlend*.09 + jumpImpact*.06)*jumpFade
    )*CFrame.Angles(
        math.rad(-8*jumpLift + 7*jumpBlend + 11*jumpImpact)*jumpFade,
        0,
        math.rad(3*jumpBlend)*jumpFade
    )
    local fade=1-adsBlend*.90
    local sprintAmplitude=1+(isReloading and sprintBlend*.3 or sprintBlend)*1.7
    local bob=CFrame.new(
        math.sin(walkClock)*.036*walkBlend*fade*sprintAmplitude,
        (math.abs(math.cos(walkClock))-.5)*.055*walkBlend*fade*sprintAmplitude - landingDip,
        math.cos(walkClock)*.013*walkBlend*fade*sprintAmplitude
    )
    local rotation=CFrame.Angles(
        math.rad(swayY*-.07)*fade,
        math.rad(swayX*-.08)*fade,
        math.sin(walkClock)*math.rad(1.7+4.0*sprintBlend)*walkBlend*fade
    )
    local knockPose=CFrame.new(.12*knockAmount,-.12*knockAmount,.16*knockAmount)
        *CFrame.Angles(math.rad(13*knockAmount),math.rad(-8*knockAmount),math.rad(11*knockAmount))
    -- Reacao visual mais forte para tapas, sem mover a camera real.
    -- A arma cai de lado, os bracos acompanham, e ela retorna suavemente.
    local slapAge=os.clock()-slapTime
    local slapWave=0
    if slapAge>=0 and slapAge<.9 then
        local attack=math.clamp(slapAge/.13,0,1)
        local release=math.clamp((.9-slapAge)/.65,0,1)
        slapWave=math.sin(attack*math.pi*.5)*release*slapStrength
    end
    local slapPose=CFrame.new(.24*slapSide*slapWave,-.30*slapWave,.25*slapWave)
        *CFrame.Angles(math.rad(24*slapWave),math.rad(-13*slapSide*slapWave),math.rad(30*slapSide*slapWave))
    -- A arma abaixa e sai parcialmente da tela quando o personagem morre.
    local deathPose=CFrame.new(.38*deathBlend,-1.65*deathBlend,.32*deathBlend)
        *CFrame.Angles(math.rad(43*deathBlend),0,math.rad(27*deathBlend))
    return camera.CFrame*offset*bob*rotation*jumpTransform*knockPose*slapPose*deathPose
        *CFrame.Angles(math.rad(pitch),math.rad(yaw),0)
end
