        if item and item:IsA("Tool") then
            pcall(function() item:Destroy() end)
        end
    end

    local watched=setmetatable({}, {__mode="k"})
    local function watchTools(container)
        if not container or watched[container] then return end
        watched[container]=true
        for _,item in ipairs(container:GetDescendants()) do
            destroyTool(item)
        end
        local c=container.DescendantAdded:Connect(destroyTool)
        table.insert(inventoryState.connections,c)
