-- Config: AIMBOT ON/OFF
-- Acompanha o alvo visivel mais proximo do centro da tela.
-- Funciona na arena; nao movimenta a camera no lobby.
-- Nao altera o viewmodel, a recarga ou os controles existentes.
-- =============================================
do
    local RADIUS_PIXELS=135
    local MAX_TARGET_DISTANCE=450
    local CAMERA_SMOOTH=11
    local TARGET_SCAN_INTERVAL=0.09
    local aimRayParams=RaycastParams.new()
    aimRayParams.FilterType=Enum.RaycastFilterType.Exclude
    aimRayParams.IgnoreWater=true

    local function visibleHead(camera,character,head)
        local origin=camera.CFrame.Position
        local direction=head.Position-origin
        if direction.Magnitude<0.01 or direction.Magnitude>MAX_TARGET_DISTANCE then
            return false
        end
        aimRayParams.FilterDescendantsInstances={plr.Character,base,arenaState.awm.model,arenaState.lagGun.model,arenaState.beretta.model}
        local hit=workspace:Raycast(origin,direction,aimRayParams)
        return not hit or hit.Instance:IsDescendantOf(character)
    end

    local function eligibleHead(camera,other,center)
        if other==plr then return nil end
        local character=other.Character
        if not character then return nil end
        local hum=character:FindFirstChildOfClass("Humanoid")
        local head=character:FindFirstChild("Head")
        if not hum or hum.Health<=0 or not head or not head:IsA("BasePart") then
            return nil
        end
        local screen,onScreen=camera:WorldToViewportPoint(head.Position)
        if not onScreen or screen.Z<=0 then return nil end
        local distance=(Vector2.new(screen.X,screen.Y)-center).Magnitude
        if distance>RADIUS_PIXELS then return nil end
        if not visibleHead(camera,character,head) then return nil end
        return head,distance
    end

    arenaState.updateAimbot=function(dt,camera)
        if not arenaState.aimbotEnabled or not arenaState.gunInArena
            or running or isReloading then
            arenaState.aimbotTarget=nil
            return
        end
        if characterHumanoid and characterHumanoid.Health<=0 then
            arenaState.aimbotTarget=nil
            return
        end
        local center=camera.ViewportSize*0.5
        local now=os.clock()
        if now>=arenaState.aimbotNextScan then
            arenaState.aimbotNextScan=now+TARGET_SCAN_INTERVAL
            local bestHead=nil
            local bestDistance=RADIUS_PIXELS+1
            for _,other in ipairs(Players:GetPlayers()) do
                local head,distance=eligibleHead(camera,other,center)
                if head and distance<bestDistance then
                    bestHead=head
                    bestDistance=distance
                end
            end
            arenaState.aimbotTarget=bestHead
        end
        local head=arenaState.aimbotTarget
        if not head or not head.Parent then return end
        local character=head.Parent
        local hum=character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then
            arenaState.aimbotTarget=nil
            return
        end
        local projected,inside=camera:WorldToViewportPoint(head.Position)
        if not inside or projected.Z<=0
            or (Vector2.new(projected.X,projected.Y)-center).Magnitude>RADIUS_PIXELS*1.3
            or not visibleHead(camera,character,head) then
            arenaState.aimbotTarget=nil
            return
        end
        local origin=camera.CFrame.Position
        local desired=CFrame.lookAt(origin,head.Position)
        camera.CFrame=camera.CFrame:Lerp(desired,math.clamp(dt*CAMERA_SMOOTH,0,1))
    end
end
-- Update only the necessary UI values; weapon movement stays full-frame.
local lastDotSize=6
-- O modelo so precisa de PivotTo se a pose realmente mudou.
local lastPosePosition,lastPoseLook,lastPoseUp=nil,nil,nil
-- Renderizar depois da camera, todos os frames. Sem saltos de 30 FPS.
RunService:BindToRenderStep(renderStepName,Enum.RenderPriority.Camera.Value+1,function(dt)
    if not active then return end
    dt=math.min(dt,1/20)
    -- Continua monitorando o lobby mesmo com a arma escondida.
    arenaState.arenaGuiCheckElapsed+=dt
    if arenaState.arenaGuiCheckElapsed>=0.5 then
        arenaState.arenaGuiCheckElapsed=0
        kstgFns.updateArenaGuis(plr.Character)
    end
    if not arenaState.gunInArena then
        arenaState.low.hide()
        awmZoomControls.Visible=false
        if base.Parent then base.Parent=nil end
        if arenaState.awm.model.Parent then arenaState.awm.model.Parent=nil end
        if arenaState.lagGun.model.Parent then arenaState.lagGun.model.Parent=nil end
        if arenaState.beretta.model.Parent then arenaState.beretta.model.Parent=nil end
        arenaState.awm.scope.Visible=false
        return
    end
    local camera=workspace.CurrentCamera
    if not camera then return end
    -- Depois de atualizar a camera padrao, acompanha alvos proximos da mira.
    arenaState.updateAimbot(dt,camera)
    if running then
        aiming=false
        triggerDown=false
    elseif triggerDown then
        kstgFns.fireShot()
    end
    recoilKick=recoilKick*math.exp(-dt*13)
    local usingAWM=arenaState.activeGun=="AWM"
    local usingLAG=arenaState.activeGun=="LAG"
    local usingBERETTA=arenaState.activeGun=="BERETTA"
    if aim.Text~="AIM" then aim.Text="AIM" end
    aim.TextColor3=Color3.fromRGB(65,225,110)
    if arenaState.lowMode then
        -- Nenhum dos modelos detalhados entra na arvore da camera em LOW.
        if base.Parent then base.Parent=nil end
        if arenaState.awm.model.Parent then arenaState.awm.model.Parent=nil end
        if arenaState.lagGun.model.Parent then arenaState.lagGun.model.Parent=nil end
        if arenaState.beretta.model.Parent then arenaState.beretta.model.Parent=nil end
    elseif usingAWM then
        if base.Parent then base.Parent=nil end
        -- AWM sempre visivel: camera olha pelo tubo 3D oco ao mirar.
        if arenaState.awm.model.Parent~=camera then
            arenaState.awm.model.Parent=camera
        end
        if arenaState.lagGun.model.Parent then arenaState.lagGun.model.Parent=nil end
        if arenaState.beretta.model.Parent then arenaState.beretta.model.Parent=nil end
    elseif usingLAG then
        if base.Parent then base.Parent=nil end
        if arenaState.awm.model.Parent then arenaState.awm.model.Parent=nil end
        if arenaState.lagGun.model.Parent~=camera then
            arenaState.lagGun.model.Parent=camera
        end
        if arenaState.beretta.model.Parent then arenaState.beretta.model.Parent=nil end
    elseif usingBERETTA then
        if base.Parent then base.Parent=nil end
        if arenaState.awm.model.Parent then arenaState.awm.model.Parent=nil end
        if arenaState.lagGun.model.Parent then arenaState.lagGun.model.Parent=nil end
        if arenaState.beretta.ready and arenaState.beretta.model.Parent~=camera then
            arenaState.beretta.model.Parent=camera
        end
    else
        if arenaState.beretta.model.Parent then arenaState.beretta.model.Parent=nil end
        if arenaState.awm.model.Parent then arenaState.awm.model.Parent=nil end
        if arenaState.lagGun.model.Parent then arenaState.lagGun.model.Parent=nil end
        if base.Parent~=camera then base.Parent=camera end
    end
    local hum=characterHumanoid
    local root=characterRoot
    local dead=hum and hum.Health<=0
    deathBlend=deathBlend+(((dead and 1 or 0)-deathBlend)*math.min(1,dt*(dead and 5 or 12)))
    if dead then
        aiming=false
        triggerDown=false
        if running then kstgFns.setRunning(false) end
    end
    -- 8X/5X sao outra GUI: permanecem no PC e no celular.
    awmZoomControls.Visible=usingAWM and aiming and not dead
    if hum and root and not dead then
        local v=root.AssemblyLinearVelocity
        local horizontal=Vector3.new(v.X,0,v.Z)
        local health=hum.Health
        -- Impacto/knockback: mudanca repentina de velocidade horizontal
        -- ou entrada no estado Physics/Ragdoll (quando suportado).
        local state=hum:GetState()
        local ragdolled=(state==Enum.HumanoidStateType.Physics
            or state==Enum.HumanoidStateType.Ragdoll
            or state==Enum.HumanoidStateType.FallingDown)
        local abrupt=previousHorizontalVelocity
            and (horizontal-previousHorizontalVelocity).Magnitude>math.max(28,dt*260)
        local hurt=previousHealth and health<previousHealth-7
        if (ragdolled or (abrupt and (hurt or horizontal.Magnitude>18)))
            and os.clock()-lastKnockTime>.75 then
            knockAmount=1
            lastKnockTime=os.clock()
            -- Tapa detectado por impulso, dano ou estado de queda.
            -- Usa a direcao do movimento para variar a inclinacao.
            local impulse=previousHorizontalVelocity
                and (horizontal-previousHorizontalVelocity) or horizontal
            slapSide=(camera.CFrame.RightVector:Dot(impulse)>=0) and 1 or -1
            slapTime=os.clock()
            slapStrength=1
        end
        previousHorizontalVelocity=horizontal
        previousHealth=health
    else
        previousHorizontalVelocity=nil
        previousHealth=hum and hum.Health or nil
    end
    knockAmount=knockAmount*math.exp(-dt*5.5)
    -- A animação usa MoveDirection, evitando ficar parada quando
    -- a velocidade física do personagem não é atualizada no cliente.
    local moveStrength=hum and hum.MoveDirection.Magnitude or 0
    local speed=root and root.AssemblyLinearVelocity.Magnitude or 0
    -- Se o jogador nao se mover nem usar a arma por 600 s, inspeciona.
    -- Nao ativa morto, pulando, correndo, atirando, mirando ou recarregando.
    local horizontalSpeed=0
    if root then
        local velocity=root.AssemblyLinearVelocity
        horizontalSpeed=Vector3.new(velocity.X,0,velocity.Z).Magnitude
    end
    local inspectionBlocked=(not hum or not root or dead)
        or (moveStrength>.05 or horizontalSpeed>1.1)
        or (hum.FloorMaterial==Enum.Material.Air)
        or running or aiming or triggerDown or isReloading
        or not arenaState.inspectEnabled
    if inspectionBlocked then
        noteInspectActivity()
    elseif not inspectActive and os.clock()-inspectLastActivity>=INSPECT_IDLE_SECONDS then
        inspectActive=true
        inspectProgress=0
    end
    if inspectActive then
        inspectProgress=math.min(1,inspectProgress+dt/INSPECT_ANIMATION_SECONDS)
        -- Entrada/saida suaves, com tempo para examinar os dois lados.
        local enter=math.clamp(inspectProgress/.16,0,1)
        local leave=math.clamp((1-inspectProgress)/.18,0,1)
        local smoothEnter=enter*enter*(3-2*enter)
        local smoothLeave=leave*leave*(3-2*leave)
        inspectWeight=smoothEnter*smoothLeave
        if inspectProgress>=1 then
            inspectActive=false
            inspectWeight=0
            inspectLastActivity=os.clock()
        end
    else
        inspectWeight+=(0-inspectWeight)*math.min(1,dt*15)
    end
    local targetWalk=(moveStrength>.05) and math.clamp(math.max(speed,hum.WalkSpeed*.65)/14,.40,1.25) or 0
    walkBlend=walkBlend+(targetWalk-walkBlend)*math.min(1,dt*10)
    local sprintTarget=(running and moveStrength>.05) and 1 or 0
    -- Som de corrida somente ao correr, andar e estar no chao.
    local footstepsOn=sprintTarget==1 and hum and hum.FloorMaterial~=Enum.Material.Air
    if footstepAudio and footstepsOn~=lastFootstepActive then
        lastFootstepActive=footstepsOn
        if footstepsOn then
            pcall(function() footstepAudio:Play() end)
        else
            footstepAudio:Stop()
        end
    end
    sprintBlend=sprintBlend+(sprintTarget-sprintBlend)*math.min(1,dt*9)
    -- AWM recebe ADS um pouco mais gradual para mostrar a subida da arma.
    adsBlend=adsBlend+((aiming and 1 or 0)-adsBlend)
        *math.min(1,dt*(usingAWM and 9 or 13))
    local stepRate=9+math.clamp(math.max(speed,walkBlend*14),0,32)*.35+sprintBlend*4
    -- Corrida 30% mais lenta visualmente, sem reduzir WalkSpeed.
    walkClock=walkClock+dt*stepRate*(1-0.30*sprintBlend)
    local delta=UIS:GetMouseDelta()
    swayX=swayX+(math.clamp(delta.X,-30,30)-swayX)*math.min(1,dt*9)
    swayY=swayY+(math.clamp(delta.Y,-30,30)-swayY)*math.min(1,dt*9)
    local grounded=hum and hum.FloorMaterial~=Enum.Material.Air
    local airborneNow=hum and hum.Health>0 and not grounded or false
    if airborneNow and previousGrounded then
        jumpLift=1
    elseif grounded and not previousGrounded then
        landingDip=.08
        jumpImpact=1
    end
    airborne=airborneNow
    verticalSpeed=root and root.AssemblyLinearVelocity.Y or 0
    jumpBlend=jumpBlend+((airborne and 1 or 0)-jumpBlend)*math.min(1,dt*9)
    jumpLift=jumpLift*math.exp(-dt*8)
    jumpImpact=jumpImpact*math.exp(-dt*11)
    previousGrounded=not not grounded
    landingDip=landingDip*math.exp(-dt*13)
    -- Evita movimentar milhares de partes se a arma nao mudou de posicao.
    -- Em movimento, ainda acompanha a camera em todos os frames.
    local newPose=pose()
    local pos=newPose.Position
    local look=newPose.LookVector
    local up=newPose.UpVector
    if arenaState.lowMode then
        -- Mesmo movimento geral e recoil, mas apenas 12-18 pecas por arma.
        arenaState.low.show(camera,arenaState.activeGun,newPose,adsBlend)
    elseif usingAWM then
        local awmPose=arenaState.awm.update(camera,newPose,recoilKick,aiming,adsBlend)
        arenaState.awm.updateHands(awmPose,adsBlend)
        arenaState.awm.updateReloadVisual(awmPose)
    elseif usingLAG then
        local lagGunPose=arenaState.lagGun.update(camera,newPose,recoilKick,adsBlend)
        arenaState.lagGun.updateHands(lagGunPose,adsBlend)
    elseif usingBERETTA then
        local berettaPose=arenaState.beretta.update(camera,newPose,recoilKick,adsBlend)
        arenaState.beretta.updateHands(berettaPose,adsBlend)
    else
        -- Recoloca as quatro peças R6 no viewmodel original da M4A1.
        for _,piece in pairs(armPieces) do
            if piece.Parent~=base then piece.Parent=base end
        end
        if not lastPosePosition
            or (pos-lastPosePosition).Magnitude>0.00004
            or (look-lastPoseLook).Magnitude>0.00005
            or (up-lastPoseUp).Magnitude>0.00005 then
            base:PivotTo(newPose)
            lastPosePosition=pos
            lastPoseLook=look
            lastPoseUp=up
        end
        kstgFns.updateWeaponCulling(dt,camera,newPose)
        kstgFns.updateM4DetachableMagazine(newPose)
        -- Mãos e braços R6 originais da M4A1.
        kstgFns.animateHands(newPose)
    end
    -- Mira original: ponto branco central em todas as armas, exceto com a luneta AWM aberta.
    local scopeOpen=usingAWM and aiming and not arenaState.lowMode
    arenaState.awm.scope.Visible=false
    reticle.Visible=arenaState.showReticle and not scopeOpen
    -- Ampliacao optica real relativa ao FOV normal de 64 graus:
    -- 8X ~= 8.94 graus; 5X ~= 14.25 graus.
    -- Mantem o zoom dentro da propria luneta 3D e a M4A1 intacta.
    local scopedFov=math.deg(2*math.atan(math.tan(math.rad(64)*.5)/awmZoomMode))
    local fovTarget=usingAWM and (aiming and scopedFov or 64) or (aiming and 38 or 70)
    camera.FieldOfView+=(fovTarget-camera.FieldOfView)*math.min(1,dt*9)
    -- Mira branca pequena durante ADS, maior ao andar sem mirar.
    local dotSize=aiming and 3 or 6
    if dotSize~=lastDotSize then
        lastDotSize=dotSize
        reticle.Size=UDim2.fromOffset(dotSize,dotSize)
    end
    -- A detecção ocorre no centro da tela e respeita obstáculos.
    kstgFns.updateCrosshairTarget(false)
end)
local function stop()
